# RESPIRACARE ENVIRONMENT CONFIGURATION (DEMO/DEVELOPMENT)
ENV=development
APP_NAME=RespiraCare
API_BASE_URL=https://demo.respiracare.health/api/v1
SUPABASE_URL=https://demo-project.supabase.co
SUPABASE_ANON_KEY=demo-anon-key-placeholder

# Set to "true" to use Supabase Auth (requires valid SUPABASE_URL/ANON_KEY).
# When false or missing, the in-app mock repository is used (default for tests/demos).
USE_SUPABASE_AUTH=false